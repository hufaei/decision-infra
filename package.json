{
  "name": "decision-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "gateway": "node --env-file-if-exists=.env --import tsx apps/gateway/src/main.ts",
    "benchmark": "tsx evals/run.ts",
    "models": "tsx apps/models/src/main.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
